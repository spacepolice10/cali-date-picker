{
  "include": ["src", "lib"],
  "compilerOptions": {
    "target": "ESNext",
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "declaration": true,
    "esModuleInterop": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "declarationMap": true,
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0"
  },
  "references": [{ "path": "./tsconfig.node.json" }]
}
